# ============================================================
# LOCAL DEVELOPMENT ENVIRONMENT (.env.local)
# ============================================================
# 
# PERHATIAN:
# - File ini untuk LOCAL DEVELOPMENT SAJA
# - TIDAK PERNAH di-commit ke Git (.gitignore sudah ada)
# - Gunakan SQLite untuk development lokal (no extra setup)
# - Gunakan .env untuk Production/Railway
#
# ============================================================

# ===== OPTION 1: SQLite (Recommended untuk quick local test) =====
DATABASE_URL=sqlite:///./auth.db

# ===== OPTION 2: Local PostgreSQL (jika sudah install) =====
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db

# ===== Auth Service Config =====
SECRET_KEY=dev-secret-key-minimum-32-characters-long-here
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
