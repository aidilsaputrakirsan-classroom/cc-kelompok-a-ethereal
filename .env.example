# ============================================================
# Global Environment Variables Example
# ============================================================

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pgpg
POSTGRES_DB=kelarin
POSTGRES_PORT_INTERNAL=5432
POSTGRES_PORT_EXTERNAL=5433

# --- Backend ---
BACKEND_PORT=8000
SECRET_KEY=your-secret-key-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# DATABASE_URL for backend service inside Docker
DATABASE_URL=postgresql://postgres:pgpg@db:5432/kelarin

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173
