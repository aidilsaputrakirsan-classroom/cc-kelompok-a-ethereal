# ==============================================================================
# DATABASE CONFIGURATIONS
# ==============================================================================
# Aktifkan salah satu untuk acuan lokal, atau biarkan di-override oleh Environment System (Railway/Docker)
DATABASE_URL=postgresql://user:password@localhost:5432/my_local_db

# 1. Local Development (Direct to Machine)
LOCAL_DATABASE_URL=postgresql://user:password@localhost:5432/my_local_db

# 2. Docker Compose Environment (Menggunakan nama service sebagai host, misal: 'db')
DOCKER_DATABASE_URL=postgresql://user:password@db:5432/my_docker_db

# 3. Railway Production (Railway biasanya otomatis menyediakan variabel DATABASE_URL sendiri)
RAILWAY_DATABASE_URL=postgresql://user:password@monorail.proxy.rlwy.net:12345/my_railway_db


# ==============================================================================
# JWT CONFIGURATIONS
# ==============================================================================
SECRET_KEY=super_secret_dan_panjang_bgt_disini_ya_jangan_pake_ini_di_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30


# ==============================================================================
# CORS CONFIGURATIONS (MULTIPLE ORIGINS)
# ==============================================================================
# Gunakan koma (,) sebagai pemisah antar URL. JANGAN beri spasi setelah koma.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://myapp.railway.app